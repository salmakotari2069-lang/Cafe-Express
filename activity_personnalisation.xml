<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imgProduit"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            tools:src="@drawable/cappuccino" />

        <TextView
            android:id="@+id/tvNomProduit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Cappuccino" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Taille"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgTaille"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbPetit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Petit" />

            <RadioButton
                android:id="@+id/rbMoyen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Moyen" />

            <RadioButton
                android:id="@+id/rbGrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grand" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Suppléments"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbLait"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lait (+1 DH)" />

        <CheckBox
            android:id="@+id/cbCreme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crème (+2 DH)" />

        <CheckBox
            android:id="@+id/cbEmporter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="À emporter (+2 DH)" />

        <TextView
            android:id="@+id/tvPrix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="21 DH" />
    </LinearLayout>
</ScrollView>